{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheWorkshopPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": "PREFIX/*"
        }
      }
    },
    {
      "Sid": "ReadWriteObjectsUnderThePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET/PREFIX/*"
    },
    {
      "Sid": "EcrLoginForImagePull",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullTheWorkshopImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:REGION:ACCOUNT_ID:repository/REPO_NAME"
    }
  ]
}
