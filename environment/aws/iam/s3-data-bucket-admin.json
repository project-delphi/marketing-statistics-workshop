{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateConfigureListAndDeleteTheBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:ListBucket",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::BUCKET"
    },
    {
      "Sid": "UploadDownloadAndDeleteObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET/*"
    }
  ]
}
